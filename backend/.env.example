# 半拍 Banpai 后端 — 环境变量示例
# 只放占位名，不要填真实密钥。复制为 .env 后填入真实值。
# cp .env.example .env

# 数据库：开发用 SQLite；生产可切 PostgreSQL，例如
# postgresql+psycopg2://USER:PASSWORD@HOST:5432/banpai
DATABASE_URL=sqlite:///./banpai.db

# JWT（HS256）签名密钥 —— 占位，部署前必须换成随机长串
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 高德地图 Key（探索页真实路线/POI/地理围栏用）—— 占位
AMAP_KEY=

# Agora（派对房间语音）—— App ID 与证书只留服务端，永不下发给客户端
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# 花语小模型服务（只接小模型 + 联网打听，不接大模型兜底）—— 占位
SMALL_MODEL_URL=
SMALL_MODEL_API_KEY=

# 素材分发：本仓库不复制大文件，只指向说明
# 素材源目录（只读说明用）：~/workspace/banpai/assets/
ASSETS_DIR=
